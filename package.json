  "dependencies": {
    "discord.js": "^14.14.1",
    "whatsapp-web.js": "^1.23.0",
    "qrcode-terminal": "^0.12.0",
    "openai": "^4.28.0",
    "@anthropic-ai/sdk": "^0.17.1",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^9.4.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "cron": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
