{
  "name": "autoguild",
  "version": "1.0.0",
  "description": "Universal AI-powered community management bot for Discord, WhatsApp, and more",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "create-plugin": "node scripts/create-plugin.js",
    "docker:build": "docker build -t autoguild .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "bot",
    "discord",
    "whatsapp",
    "community-management",
    "ai",
    "moderation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "whatsapp-web.js": "^1.23.0",
    "qrcode-terminal": "^0.12.0",
    "node-telegram-bot-api": "^0.64.0",
    "@slack/bolt": "^3.17.0",
    "botbuilder": "^4.21.0",
    "matrix-js-sdk": "^31.0.0",
    "ws": "^8.16.0",
    "openai": "^4.28.0",
    "@anthropic-ai/sdk": "^0.17.1",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^9.4.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "cron": "^3.1.6",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node-telegram-bot-api": "^0.64.0",
    "@types/ws": "^8.5.10",
    "@types/cron": "^2.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
