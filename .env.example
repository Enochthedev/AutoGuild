# Bot Configuration
NODE_ENV=development
LOG_LEVEL=info
COMMAND_PREFIX=!

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# WhatsApp Configuration (uses QR code authentication)
WHATSAPP_ENABLED=false

# Telegram Configuration
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Slack Configuration
SLACK_ENABLED=false
SLACK_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_PORT=3002

# Microsoft Teams Configuration
TEAMS_ENABLED=false
TEAMS_APP_ID=your_teams_app_id_here
TEAMS_APP_PASSWORD=your_teams_app_password_here

# AI Provider Configuration
# Choose your AI provider: openai, anthropic, or both
AI_PROVIDER=anthropic

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database
DATABASE_PATH=./data/autoguild.db

# Web Dashboard & API
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000

# Features
ENABLE_MODERATION=true
ENABLE_ANALYTICS=true
ENABLE_ENGAGEMENT_TRACKING=true
ENABLE_AUTO_RESPONSES=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Webhooks (optional)
WEBHOOK_PORT=3001
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Monitoring (optional)
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
